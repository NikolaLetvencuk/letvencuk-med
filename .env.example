# Kopirajte ovaj fajl u .env i popunite vrednosti. .env se NE commit-uje.
# Iste promenljive se u produkciji podešavaju u Vercel -> Settings -> Environment Variables.

# Gemini API ključ iz Google AI Studio (aistudio.google.com). Samo za server — nikad VITE_ prefiks.
GEMINI_API_KEY=

# Tačan ID modela iz AI Studio liste modela (npr. neki aktuelni "Flash" model).
# Ako je prazno, koristi se podrazumevani model iz api/chat.ts.
GEMINI_MODEL=

# Dozvoljeni domeni sajta (odvojeni zarezom). Localhost i *.vercel.app domen deploy-a su uvek dozvoljeni.
# Primer: https://medletvencuk.rs,https://www.medletvencuk.rs
ALLOWED_ORIGINS=

# Koliko model "razmišlja" pre odgovora: MINIMAL (podrazumevano, najbrže/najjeftinije),
# LOW, MEDIUM, HIGH, ili "default" (model sam odlučuje). Ako model ne podržava nivo,
# kod automatski ponovi zahtev bez njega.
GEMINI_THINKING_LEVEL=
